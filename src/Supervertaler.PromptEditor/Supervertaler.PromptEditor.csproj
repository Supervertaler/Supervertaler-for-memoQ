<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net48 so the editor needs nothing installed: .NET Framework 4.8 ships
         with Windows 10 1903 and later, and every machine that runs memoQ 12 or
         Trados already has it. A net8 build would be a runtime download for the
         sake of a two-window utility. -->
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Supervertaler.PromptEditor</RootNamespace>
    <AssemblyName>Supervertaler.PromptEditor</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Authors>Michael Beijer</Authors>
    <Company>Supervertaler</Company>
    <Product>Supervertaler for memoQ</Product>
    <Description>Prompts, glossary and settings for Supervertaler for memoQ</Description>
    <Copyright>Copyright (c) 2026 Michael Beijer</Copyright>
    <Version>0.1.0</Version>
    <InformationalVersion>0.1.0</InformationalVersion>
    <ApplicationIcon>..\Supervertaler.MemoQ\Resources\sv-icon.ico</ApplicationIcon>
    <!-- Declares DPI awareness, so the window is not bitmap-stretched into
         blur on a scaled display. See app.manifest. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!--
    The whole point of this project: the prompt library's parser and writer come
    from Core, so the editor cannot disagree with either plugin about the file
    format. Re-implementing frontmatter handling here — in this language or any
    other — is what put nine keys at risk of being silently deleted the last time
    two things claimed to understand the format.
  -->
  <Import Project="..\..\core\Supervertaler.Core.props" />

  <!--
    Embedded as well as set as the exe icon: ExtractAssociatedIcon returns
    one rescaled frame, and reading the .ico directly lets Windows pick the
    right frame per window and per DPI.
  -->
  <ItemGroup>
    <!-- The SQLite stack memoQ already loads. Private=false throughout: these
         are memoQ's copies, used in place, never copied into Addins. Its own
         termbase engine (MemoQ.NGTB.dll) is built on the same three.
         SQLitePCLRaw.provider.dynamic_cdecl is not referenced because no type
         of ours names it - Batteries_V2 reaches it at runtime, out of memoQ's
         own directory. -->
    <Reference Include="Microsoft.Data.Sqlite">
      <HintPath>$(MemoQPath)\Microsoft.Data.Sqlite.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SQLitePCLRaw.core">
      <HintPath>$(MemoQPath)\SQLitePCLRaw.core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SQLitePCLRaw.batteries_v2">
      <HintPath>$(MemoQPath)\SQLitePCLRaw.batteries_v2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <EmbeddedResource Include="..\Supervertaler.MemoQ\Resources\sv-icon.ico">
      <LogicalName>Supervertaler.PromptEditor.Resources.sv-icon.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- For the bridge client (AutoPrompt): not in net48's default SDK reference set. -->
    <Reference Include="System.Net.Http" />
    <!-- For reading the Trados key store, which is JSON. -->
    <Reference Include="System.Runtime.Serialization" />
    <!-- For the font's own character map, which is how a missing icon
         glyph is told from a present one. Part of the .NET Framework, not
         a package: nothing is redistributed. -->
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The same source file the memoQ plugin compiles, not a copy. The active
      glossary is one setting in one file that both processes write, so both
      must agree on its format down to the line endings.
    -->
    <Compile Include="..\Supervertaler.MemoQ\Core\TermbaseSelection.cs">
      <Link>Core\TermbaseSelection.cs</Link>
    </Compile>
    <Compile Include="..\Supervertaler.MemoQ\Core\TermbaseDb.cs">
      <Link>Core\TermbaseDb.cs</Link>
    </Compile>
    <Compile Include="..\Supervertaler.MemoQ\Core\TermbaseSchema.cs">
      <Link>Core\TermbaseSchema.cs</Link>
    </Compile>
    <Compile Include="..\Supervertaler.MemoQ\Core\TermbaseWriter.cs">
      <Link>Core\TermbaseWriter.cs</Link>
    </Compile>
    <Compile Include="..\Supervertaler.MemoQ\Core\TermbaseFiles.cs">
      <Link>Core\TermbaseFiles.cs</Link>
    </Compile>
    <Compile Include="..\Supervertaler.MemoQ\Core\TermIndex.cs">
      <Link>Core\TermIndex.cs</Link>
    </Compile>
    <!-- TermIndex matches against folded text, so the editor needs this too. -->
    <Compile Include="..\Supervertaler.MemoQ\Core\ScriptChars.cs">
      <Link>Core\ScriptChars.cs</Link>
    </Compile>
    <Compile Include="..\Supervertaler.MemoQ\Core\TermText.cs">
      <Link>Core\TermText.cs</Link>
    </Compile>
    <Compile Include="..\Supervertaler.MemoQ\Core\SharedSettings.cs">
      <Link>Shared\SharedSettings.cs</Link>
    </Compile>
    <Compile Include="..\Supervertaler.MemoQ\Settings\LlmProviders.cs">
      <Link>Shared\LlmProviders.cs</Link>
    </Compile>
    <Compile Include="..\Supervertaler.MemoQ\Core\ApiKeys.cs">
      <Link>Shared\ApiKeys.cs</Link>
    </Compile>
    <Compile Include="..\Supervertaler.MemoQ\Core\GlossaryDirection.cs">
      <Link>Shared\GlossaryDirection.cs</Link>
    </Compile>
    <Compile Include="..\Supervertaler.MemoQ\Core\ModelCatalog.cs">
      <Link>Shared\ModelCatalog.cs</Link>
    </Compile>
    <Compile Include="..\Supervertaler.MemoQ\Core\MemoQSession.cs">
      <Link>Shared\MemoQSession.cs</Link>
    </Compile>
    <Compile Include="..\Supervertaler.MemoQ\Core\Licence.cs">
      <Link>Shared\Licence.cs</Link>
    </Compile>
    <Compile Include="..\Supervertaler.MemoQ\Core\DefaultPrompts.cs">
      <Link>Shared\DefaultPrompts.cs</Link>
    </Compile>
    <Compile Include="..\Supervertaler.MemoQ\Core\MemoryBankChoice.cs">
      <Link>Shared\MemoryBankChoice.cs</Link>
    </Compile>
    <Compile Include="..\Supervertaler.MemoQ\Settings\MemoryBankPicker.cs">
      <Link>Shared\MemoryBankPicker.cs</Link>
    </Compile>
    <Compile Include="..\Supervertaler.MemoQ\Core\DocumentFiles.cs">
      <Link>Shared\DocumentFiles.cs</Link>
    </Compile>
  </ItemGroup>

</Project>
